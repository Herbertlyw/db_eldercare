digraph G { graph [rankdir=TB,bgcolor="white",nodesep=0.45,ranksep=0.65,pad=0.18,splines=polyline,outputorder=edgesfirst]; node [fontname="Noto Sans CJK SC",fontsize=16]; edge [fontname="Noto Sans CJK SC",fontsize=11,color="#80949e",arrowsize=0.5,penwidth=1.1,labeldistance=1.9];
elder [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>老人档案</B></FONT><BR/><FONT POINT-SIZE="14">elder</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">community_id ↗</TD></TR></TABLE>>];
service_item [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>服务项目</B></FONT><BR/><FONT POINT-SIZE="14">service_item</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR></TABLE>>];
service_order [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>服务订单</B></FONT><BR/><FONT POINT-SIZE="14">service_order</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">elder_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">item_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">community_id ↗</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">created_by ↗</TD></TR></TABLE>>];
dispatch [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>派单记录</B></FONT><BR/><FONT POINT-SIZE="14">dispatch</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">order_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">shift_id</TD></TR></TABLE>>];
service_record [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>服务与确认</B></FONT><BR/><FONT POINT-SIZE="14">service_record</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">dispatch_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">confirmed_by ↗</TD></TR></TABLE>>];
attendance [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>工时记录</B></FONT><BR/><FONT POINT-SIZE="14">attendance</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">dispatch_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">reviewer_id ↗</TD></TR></TABLE>>];
shift [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>排班</B></FONT><BR/><FONT POINT-SIZE="14">shift</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">caregiver_id ↗</TD></TR></TABLE>>];
dispatch -> attendance [arrowhead=none,taillabel="1",headlabel="0..1"];
service_order -> dispatch [arrowhead=none,taillabel="1",headlabel="0..*"];
shift -> dispatch [arrowhead=none,taillabel="1",headlabel="0..*"];
elder -> service_order [arrowhead=none,taillabel="1",headlabel="0..*"];
service_item -> service_order [arrowhead=none,taillabel="1",headlabel="0..*"];
dispatch -> service_record [arrowhead=none,taillabel="1",headlabel="0..1"];
{rank=same;elder;service_item;shift;}
{rank=same;service_order;}
{rank=same;dispatch;}
{rank=same;service_record;attendance;}
}
