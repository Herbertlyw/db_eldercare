digraph G { graph [rankdir=LR, bgcolor="white",nodesep=0.35,ranksep=0.7]; node [fontname="Noto Sans CJK SC",fontsize=14,color="#31574e"]; edge [fontname="Noto Sans CJK SC",fontsize=10,color="#719087",arrowsize=0.6];
organization [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#e7efea" WIDTH="178"><B>服务机构</B><BR/>organization</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">id  PK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">community_id  FK</TD></TR></TABLE>>];
account [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#e7efea" WIDTH="206"><B>账号</B><BR/>account</TD></TR><TR><TD ALIGN="LEFT" WIDTH="206">id  PK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="206">username  UQ</TD></TR><TR><TD ALIGN="LEFT" WIDTH="206">community_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="206">organization_id  FK</TD></TR></TABLE>>];
caregiver [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#e7efea" WIDTH="206"><B>护工</B><BR/>caregiver</TD></TR><TR><TD ALIGN="LEFT" WIDTH="206">id  PK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="206">account_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="206">organization_id  FK</TD></TR></TABLE>>];
credential [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#e7efea" WIDTH="197"><B>项目资质</B><BR/>credential</TD></TR><TR><TD ALIGN="LEFT" WIDTH="197">id  PK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="197">caregiver_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="197">item_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="197">certificate_no  UQ</TD></TR></TABLE>>];
caregiver_area [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#e7efea" WIDTH="178"><B>护工服务区域</B><BR/>caregiver_area</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">id  PK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">caregiver_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">community_id  FK</TD></TR></TABLE>>];
community [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#e7efea" WIDTH="150"><B>社区</B><BR/>community</TD></TR><TR><TD ALIGN="LEFT" WIDTH="150">id  PK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="150">area_code  UQ</TD></TR></TABLE>>];
shift [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#e7efea" WIDTH="178"><B>排班</B><BR/>shift</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">id  PK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">caregiver_id  FK</TD></TR></TABLE>>];
attendance [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#e7efea" WIDTH="169"><B>工时记录</B><BR/>attendance</TD></TR><TR><TD ALIGN="LEFT" WIDTH="169">id  PK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="169">dispatch_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="169">reviewer_id  FK</TD></TR></TABLE>>];
dispatch [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#e7efea" WIDTH="178"><B>派单记录</B><BR/>dispatch</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">id  PK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">order_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">shift_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">active_order  UQ</TD></TR></TABLE>>];
community -> account [arrowhead=none,taillabel="1",headlabel="0..*"];
organization -> account [arrowhead=none,taillabel="0..1",headlabel="0..*"];
dispatch -> attendance [arrowhead=none,taillabel="1",headlabel="0..1"];
account -> attendance [arrowhead=none,taillabel="0..1",headlabel="0..*"];
account -> caregiver [arrowhead=none,taillabel="1",headlabel="0..1"];
organization -> caregiver [arrowhead=none,taillabel="1",headlabel="0..*"];
caregiver -> caregiver_area [arrowhead=none,taillabel="1",headlabel="0..*"];
community -> caregiver_area [arrowhead=none,taillabel="1",headlabel="0..*"];
caregiver -> credential [arrowhead=none,taillabel="1",headlabel="0..*"];
shift -> dispatch [arrowhead=none,taillabel="1",headlabel="0..*"];
community -> organization [arrowhead=none,taillabel="1",headlabel="0..*"];
caregiver -> shift [arrowhead=none,taillabel="1",headlabel="0..*"];
}
