digraph G { graph [rankdir=TB,bgcolor="white",nodesep=0.45,ranksep=0.65,pad=0.18,splines=polyline,outputorder=edgesfirst]; node [fontname="Noto Sans CJK SC",fontsize=16]; edge [fontname="Noto Sans CJK SC",fontsize=11,color="#80949e",arrowsize=0.5,penwidth=1.1,labeldistance=1.9];
service_order [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>服务订单</B></FONT><BR/><FONT POINT-SIZE="14">service_order</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">elder_id ↗</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">item_id ↗</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">community_id ↗</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">created_by ↗</TD></TR></TABLE>>];
complaint [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>评价投诉</B></FONT><BR/><FONT POINT-SIZE="14">complaint</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">order_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">account_id ↗</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="173">organization_id ↗</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">handler_id ↗</TD></TR></TABLE>>];
complaint_log [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>投诉办理记录</B></FONT><BR/><FONT POINT-SIZE="14">complaint_log</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">complaint_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">actor_id ↗</TD></TR></TABLE>>];
service_order -> complaint [arrowhead=none,taillabel="1",headlabel="0..*"];
complaint -> complaint_log [arrowhead=none,taillabel="1",headlabel="0..*"];
{rank=same;service_order;}
{rank=same;complaint;}
}
