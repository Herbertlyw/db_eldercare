digraph G { graph [rankdir=LR, bgcolor="white",nodesep=0.35,ranksep=0.7]; node [fontname="Noto Sans CJK SC",fontsize=14,color="#31574e"]; edge [fontname="Noto Sans CJK SC",fontsize=10,color="#719087",arrowsize=0.6];
elder [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#e7efea" WIDTH="187"><B>老人档案</B><BR/>elder</TD></TR><TR><TD ALIGN="LEFT" WIDTH="187">id  PK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="187">identity_hash  UQ</TD></TR><TR><TD ALIGN="LEFT" WIDTH="187">community_id  FK</TD></TR></TABLE>>];
service_order [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#e7efea" WIDTH="178"><B>服务订单</B><BR/>service_order</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">id  PK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">elder_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">item_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">community_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">created_by  FK</TD></TR></TABLE>>];
policy [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#e7efea" WIDTH="178"><B>补贴政策</B><BR/>policy</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">id  PK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">community_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">item_id  FK</TD></TR></TABLE>>];
claim [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#e7efea" WIDTH="150"><B>补贴申报</B><BR/>claim</TD></TR><TR><TD ALIGN="LEFT" WIDTH="150">id  PK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="150">elder_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="150">item_id  FK</TD></TR></TABLE>>];
claim_item [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#e7efea" WIDTH="150"><B>申报明细</B><BR/>claim_item</TD></TR><TR><TD ALIGN="LEFT" WIDTH="150">id  PK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="150">claim_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="150">policy_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="150">order_id  FK</TD></TR></TABLE>>];
claim_review [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#e7efea" WIDTH="169"><B>审核记录</B><BR/>claim_review</TD></TR><TR><TD ALIGN="LEFT" WIDTH="169">id  PK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="169">claim_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="169">reviewer_id  FK</TD></TR></TABLE>>];
payment [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#e7efea" WIDTH="178"><B>拨付</B><BR/>payment</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">id  PK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">claim_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">reference_no  UQ</TD></TR></TABLE>>];
inspection [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#e7efea" WIDTH="178"><B>质量抽查</B><BR/>inspection</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">id  PK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">order_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">caregiver_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="178">inspector_id  FK</TD></TR></TABLE>>];
account [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#e7efea" WIDTH="206"><B>账号</B><BR/>account</TD></TR><TR><TD ALIGN="LEFT" WIDTH="206">id  PK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="206">username  UQ</TD></TR><TR><TD ALIGN="LEFT" WIDTH="206">community_id  FK</TD></TR><TR><TD ALIGN="LEFT" WIDTH="206">organization_id  FK</TD></TR></TABLE>>];
elder -> claim [arrowhead=none,taillabel="1",headlabel="0..*"];
claim -> claim_item [arrowhead=none,taillabel="1",headlabel="0..*"];
