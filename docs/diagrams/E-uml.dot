service_order -> inspection [arrowhead=none,taillabel="0..1",headlabel="0..*"];
claim -> payment [arrowhead=none,taillabel="1",headlabel="0..1"];
account -> service_order [arrowhead=none,taillabel="1",headlabel="0..*"];
elder -> service_order [arrowhead=none,taillabel="1",headlabel="0..*"];
}
