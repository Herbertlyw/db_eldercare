digraph G { graph [rankdir=TB,bgcolor="white",nodesep=0.45,ranksep=0.65,pad=0.18,splines=polyline,outputorder=edgesfirst]; node [fontname="Noto Sans CJK SC",fontsize=16]; edge [fontname="Noto Sans CJK SC",fontsize=11,color="#80949e",arrowsize=0.5,penwidth=1.1,labeldistance=1.9];
policy [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>补贴政策</B></FONT><BR/><FONT POINT-SIZE="14">policy</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">community_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">item_id</TD></TR></TABLE>>];
policy_area [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>政策适用社区</B></FONT><BR/><FONT POINT-SIZE="14">policy_area</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">policy_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">community_id</TD></TR></TABLE>>];
community [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>社区</B></FONT><BR/><FONT POINT-SIZE="14">community</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR></TABLE>>];
service_item [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>服务项目</B></FONT><BR/><FONT POINT-SIZE="14">service_item</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR></TABLE>>];
community -> policy [arrowhead=none,taillabel="1",headlabel="0..*"];
service_item -> policy [arrowhead=none,taillabel="1",headlabel="0..*"];
community -> policy_area [arrowhead=none,taillabel="1",headlabel="0..*"];
policy -> policy_area [arrowhead=none,taillabel="1",headlabel="0..*"];
{rank=same;policy;}
}
