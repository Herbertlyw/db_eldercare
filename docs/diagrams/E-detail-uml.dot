digraph G { graph [rankdir=TB,bgcolor="white",nodesep=0.45,ranksep=0.65,pad=0.18,splines=polyline,outputorder=edgesfirst]; node [fontname="Noto Sans CJK SC",fontsize=16]; edge [fontname="Noto Sans CJK SC",fontsize=11,color="#80949e",arrowsize=0.5,penwidth=1.1,labeldistance=1.9];
claim [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>补贴申报</B></FONT><BR/><FONT POINT-SIZE="14">claim</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">elder_id ↗</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">item_id ↗</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">community_id ↗</TD></TR></TABLE>>];
claim_item [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>申报明细</B></FONT><BR/><FONT POINT-SIZE="14">claim_item</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">claim_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">policy_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">order_id</TD></TR></TABLE>>];
policy [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>补贴政策</B></FONT><BR/><FONT POINT-SIZE="14">policy</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">community_id ↗</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">item_id ↗</TD></TR></TABLE>>];
service_order [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>服务订单</B></FONT><BR/><FONT POINT-SIZE="14">service_order</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">elder_id ↗</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">item_id ↗</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">community_id ↗</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">created_by ↗</TD></TR></TABLE>>];
inspection [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>质量抽查</B></FONT><BR/><FONT POINT-SIZE="14">inspection</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">order_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">caregiver_id ↗</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">inspector_id ↗</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">batch_id ↗</TD></TR></TABLE>>];
claim -> claim_item [arrowhead=none,taillabel="1",headlabel="0..*"];
service_order -> claim_item [arrowhead=none,taillabel="1",headlabel="0..1"];
policy -> claim_item [arrowhead=none,taillabel="1",headlabel="0..*"];
service_order -> inspection [arrowhead=none,taillabel="0..1",headlabel="0..*"];
{rank=same;service_order;policy;}
{rank=same;claim;}
{rank=same;claim_item;inspection;}
}
