digraph G { graph [rankdir=TB,bgcolor="white",nodesep=0.45,ranksep=0.65,pad=0.18,splines=polyline,outputorder=edgesfirst]; node [fontname="Noto Sans CJK SC",fontsize=16]; edge [fontname="Noto Sans CJK SC",fontsize=11,color="#80949e",arrowsize=0.5,penwidth=1.1,labeldistance=1.9];
elder [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>老人档案</B></FONT><BR/><FONT POINT-SIZE="14">elder</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">community_id ↗</TD></TR></TABLE>>];
elder_tag [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>老人标签</B></FONT><BR/><FONT POINT-SIZE="14">elder_tag</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">elder_id</TD></TR></TABLE>>];
guardian [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>家属关联</B></FONT><BR/><FONT POINT-SIZE="14">guardian</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">elder_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">account_id ↗</TD></TR></TABLE>>];
assessment [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>能力评估</B></FONT><BR/><FONT POINT-SIZE="14">assessment</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">elder_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">assessor_id ↗</TD></TR></TABLE>>];
care_plan [shape=plain,label=<<TABLE BORDER="1" COLOR="#9AAAB2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" WIDTH="205" BGCOLOR="#EDF4F1"><FONT POINT-SIZE="19"><B>照护计划</B></FONT><BR/><FONT POINT-SIZE="14">care_plan</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">PK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">assessment_id</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">bundle_id ↗</TD></TR><TR><TD ALIGN="LEFT" WIDTH="40"><FONT COLOR="#697C88">FK</FONT></TD><TD ALIGN="LEFT" WIDTH="165">caregiver_id ↗</TD></TR></TABLE>>];
elder -> assessment [arrowhead=none,taillabel="1",headlabel="0..*"];
assessment -> care_plan [arrowhead=none,taillabel="1",headlabel="0..*"];
elder -> elder_tag [arrowhead=none,taillabel="1",headlabel="0..*"];
